{
  "name": "mediagrab",
  "version": "2.0.0",
  "type": "module",
  "description": "Save images, GIFs and videos from any page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhusudan-kulkarni/image-grab.git"
  },
  "homepage": "https://github.com/madhusudan-kulkarni/image-grab#readme",
  "bugs": {
    "url": "https://github.com/madhusudan-kulkarni/image-grab/issues"
  },
  "keywords": [
    "browser-extension",
    "image-downloader",
    "image-grabber",
    "batch-downloader",
    "wxt",
    "chrome-extension",
    "firefox-addon"
  ],
  "author": "Madhusudan Kulkarni",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "icons": "node scripts/generate-icons.js",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "sign:firefox": "wxt zip -b firefox && npx --yes web-ext sign --source-dir output/firefox-mv3 --artifacts-dir output/signed --channel unlisted",
    "updates": "node scripts/write-updates.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
